# Railway backend — copy values into the service Variables tab.
# Do not commit real secrets.

SPRING_PROFILES_ACTIVE=prod,railway

# Linked automatically if you reference the Postgres plugin:
# DATABASE_URL=${{Postgres.DATABASE_URL}}
# DATABASE_PRIVATE_URL=${{Postgres.DATABASE_PRIVATE_URL}}
POSTGRES_SCHEMA=public

# At least 32 characters. Generate with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
JWT_ISSUER=syncro
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30

ADMIN_BOOTSTRAP_SECRET=change-me-admin-bootstrap-secret

# Local frontend talking to this API through Next.js rewrites
CORS_ALLOWED_ORIGINS=http://localhost:3000
AUTH_AUTO_VERIFY_EMAIL=true

MEDIA_STORAGE_PATH=/data/media
SWISS_EPHEMERIS_PATH=/data/ephe

# Optional. Leave blank for a first login/register test.
BREVO_API_KEY=
OPENAI_API_KEY=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_MAPS_API_KEY=
VIATOR_API_KEY=
VIATOR_SYNC_ENABLED=false
ZYRA_PROVIDER=OPENAI
